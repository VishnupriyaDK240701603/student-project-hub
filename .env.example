# Environment Variables Template (DO NOT PUT REAL KEYS HERE)

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example_anon_key_dummy_value
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=example_service_role_key_dummy_value

# Hugging Face AI Configuration
HF_TOKEN=hf_dummy_token_example
HF_PROVIDER=dummy_provider
HF_MODEL=dummy_model
AI_ENABLED=false

# Resend Email Configuration
RESEND_API_KEY=re_dummy_resend_api_key
EMAIL_FROM=noreply@example.com
EMAIL_TEST_RECIPIENT=test-owner@example.com

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=example_vapid_public_key
VAPID_PRIVATE_KEY=example_vapid_private_key

# Application Environment (local | staging | production)
APP_ENV=local

# Non-production allowed test emails (comma-separated)
DEMO_ALLOWED_EMAILS=student.test.22.cse@rajlakshmi.edu.in,staff.test.cse@rajlakshmi.edu.in
